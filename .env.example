# === Anthropic Claude API ===
# Obtenha em: https://console.anthropic.com/
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# === Amadeus Travel API (opcional - modo demo sem chaves) ===
# Registre-se gratuitamente em: https://developers.amadeus.com/
AMADEUS_API_KEY=your_amadeus_api_key_here
AMADEUS_API_SECRET=your_amadeus_secret_here
# Use "test" para ambiente de testes ou "production" para produção
AMADEUS_HOSTNAME=test

# === Configurações do App ===
# Moeda padrão (BRL, USD, EUR)
DEFAULT_CURRENCY=BRL
# Idioma (pt-BR, en-US)
APP_LANG=pt-BR
# Habilitar modo demo (true = dados simulados, false = APIs reais)
DEMO_MODE=false
