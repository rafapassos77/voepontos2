{
      "version": 2,
      "builds": [
              {
                        "src": "src/web/server.py",
                        "use": "@vercel/python"
              },
              {
                        "src": "web/index.html",
                        "use": "@vercel/static"
              }
      ],
      "routes": [
              {
                        "src": "/api/(.*)",
                        "dest": "src/web/server.py"
              },
              {
                        "src": "/(.*)",
                        "dest": "web/index.html"
              }
      ]
}
